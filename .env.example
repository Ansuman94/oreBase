# Copy this file to .env and fill in your values.
# Never commit .env — it is git-ignored.

# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server port (optional, defaults to 3001)
PORT=3001

# JWT signing secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-48-byte-hex-random
JWT_REFRESH_SECRET=replace-with-48-byte-hex-random

# Microsoft Clarity project ID
# Get it from: https://clarity.microsoft.com → your project → Settings → Overview
VITE_CLARITY_PROJECT_ID=your-clarity-project-id
